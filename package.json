{
  "name": "project-starter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "start": "bun run src/server.ts",
    "format": "bunx prettier . --write",
    "format:check": "bunx prettier . --check",
    "db:generate": "bunx drizzle-kit generate --name=dev",
    "db:migrate": "bunx drizzle-kit migrate",
    "db:push": "bunx drizzle-kit push",
    "db:studio": "bunx drizzle-kit studio",
    "seed": "bun src/scripts/seed.ts"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.0",
    "@elysiajs/swagger": "^1.3.1",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.1",
    "elysia": "^1.4.19",
    "pino": "^10.1.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.5",
    "@types/node": "^24.10.0",
    "bun-types": "^1.3.2",
    "drizzle-kit": "^0.31.8",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.7",
    "prettier": "^3.0.0",
    "typescript": "^5.9.3"
  }
}
